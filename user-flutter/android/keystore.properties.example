# Release signing configuration for android/app/build.gradle.kts.
#
# Copy this file to `keystore.properties` (next to it), fill in the real
# values, and place your release keystore somewhere safe. `keystore.properties`
# is gitignored and must never be committed.
#
# Generate a keystore with:
#   keytool -genkey -v -keystore omnivote-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias omnivote
#
storeFile=/absolute/path/to/omnivote-release.jks
storePassword=CHANGE_ME
keyAlias=omnivote
keyPassword=CHANGE_ME