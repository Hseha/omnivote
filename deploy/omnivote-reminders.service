# ============================================================================
# OmniVote — vote-deadline reminder (one-shot)
# ----------------------------------------------------------------------------
# Runs `omnivote:send-vote-reminders`, which during the final hour before the
# polls close messages every active voter who has not cast a ballot yet
# (in-app notification + FCM push), once per voter. Driven by
# omnivote-reminders.timer.
#
# Install:
#   sudo cp deploy/omnivote-reminders.service /etc/systemd/system/
#   sudo cp deploy/omnivote-reminders.timer   /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now omnivote-reminders.timer
#
# Verify:
#   systemctl list-timers omnivote-reminders.timer
#   journalctl -u omnivote-reminders -n 20
#   (dry run) php artisan omnivote:send-vote-reminders --dry-run
# ============================================================================

[Unit]
Description=OmniVote vote-deadline reminders
After=network.target mysql.service mariadb.service
Wants=mysql.service mariadb.service

[Service]
Type=oneshot
User=www-data
Group=www-data

# Pin php8.4; adjust to the installed PHP 8.x version if different.
ExecStart=/usr/bin/php8.4 /var/www/omnivote/backend-laravel/artisan omnivote:send-vote-reminders

StandardOutput=journal
StandardError=journal
SyslogIdentifier=omnivote-reminders
