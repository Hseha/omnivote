# ============================================================================
# OmniVote — closed-cycle archive (one-shot)
# ----------------------------------------------------------------------------
# Runs `omnivote:archive-closed-cycle`, which reads the live election phase
# and, when the polls have closed, captures the cycle's roster, ballot and
# turnout into the Election Records archive.
#
# The archive also runs on the phase transition itself, on the first request
# that reads the phase after the deadline. This unit is the backstop: it
# ticks on a timer, so a cycle is captured even when nobody opens the
# console or the student app between the polls closing and the next working
# day. The archive is idempotent per cycle, so repeated runs are harmless.
#
# Install:
#   sudo cp deploy/omnivote-archive-cycle.service /etc/systemd/system/
#   sudo cp deploy/omnivote-archive-cycle.timer   /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now omnivote-archive-cycle.timer
#
# Verify:
#   systemctl list-timers omnivote-archive-cycle.timer
#   journalctl -u omnivote-archive-cycle -n 20
#   (dry run) php artisan omnivote:archive-closed-cycle
# ============================================================================

[Unit]
Description=OmniVote closed election cycle archive
After=network.target mysql.service mariadb.service
Wants=mysql.service mariadb.service

[Service]
Type=oneshot
User=www-data
Group=www-data

# Pin php8.4; adjust to the installed PHP 8.x version if different.
ExecStart=/usr/bin/php8.4 /var/www/omnivote/backend-laravel/artisan omnivote:archive-closed-cycle

StandardOutput=journal
StandardError=journal
SyslogIdentifier=omnivote-archive-cycle
