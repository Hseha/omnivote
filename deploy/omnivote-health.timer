# ============================================================================
# OmniVote — server health check timer
# ----------------------------------------------------------------------------
# Fires omnivote-health.service every 5 minutes (and once shortly after boot).
# Persistent=true means a run missed while the host was off is executed on the
# next boot. Alerts are only written on a status transition, so a steady-state
# problem does not spam the admin notification center.
#
# Install (with the matching .service):
#   sudo cp deploy/omnivote-health.service /etc/systemd/system/
#   sudo cp deploy/omnivote-health.timer   /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now omnivote-health.timer
# ============================================================================

[Unit]
Description=Run the OmniVote server health check every 5 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
Persistent=true

[Install]
WantedBy=timers.target
