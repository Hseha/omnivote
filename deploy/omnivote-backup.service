# ============================================================================
# OmniVote — scheduled encrypted election backup (one-shot)
# ----------------------------------------------------------------------------
# Runs `omnivote:backup`, which writes an AES-256-GCM snapshot under
# storage/app/backups and prunes files older than the configured retention
# (Settings → Backup). Driven by omnivote-backup.timer.
#
# Install:
#   sudo cp deploy/omnivote-backup.service /etc/systemd/system/
#   sudo cp deploy/omnivote-backup.timer   /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now omnivote-backup.timer
#
# Verify:
#   systemctl list-timers omnivote-backup.timer
#   journalctl -u omnivote-backup -n 20
# ============================================================================

[Unit]
Description=OmniVote encrypted election backup
After=network.target mysql.service mariadb.service
Wants=mysql.service mariadb.service

[Service]
Type=oneshot
User=www-data
Group=www-data

# Pin php8.3; adjust to the installed PHP 8.x version if different.
ExecStart=/usr/bin/php8.3 /var/www/omnivote/backend-laravel/artisan omnivote:backup

StandardOutput=journal
StandardError=journal
SyslogIdentifier=omnivote-backup
