# ============================================================================
# OmniVote — vote-deadline reminder timer
# ----------------------------------------------------------------------------
# Fires omnivote-reminders.service every 10 minutes (and once shortly after
# boot). The command itself decides whether the final hour before
# `voting_closes_at` is active and skips silently outside it, so a 10-minute
# cadence is always safe: voters are deduplicated by the vote_reminders
# ledger and each voter is messaged at most once per stage.
#
# Install (with the matching .service):
#   sudo cp deploy/omnivote-reminders.service /etc/systemd/system/
#   sudo cp deploy/omnivote-reminders.timer   /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now omnivote-reminders.timer
# ============================================================================

[Unit]
Description=Run the OmniVote vote-deadline reminders every 10 minutes

[Timer]
OnBootSec=5min
OnUnitActiveSec=10min
Persistent=true

[Install]
WantedBy=timers.target
