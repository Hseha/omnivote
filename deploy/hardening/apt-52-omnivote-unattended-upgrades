// OmniVote server hardening — unattended-upgrades scope
// (installed at /etc/apt/apt.conf.d/52-omnivote-unattended-upgrades by
// deploy/harden-server.sh).
//
// Security updates only, and never reboot automatically. Apply the kernel
// update by hand at a time you choose (the running kernel only changes on
// reboot). deploy/harden-server.sh also comments out the general
// "label=Debian" origin in the distro conffile, because apt appends origin
// lists across files rather than replacing them.
Unattended-Upgrade::Origins-Pattern {
        "origin=Debian,codename=${distro_codename},label=Debian-Security";
        "origin=Debian,codename=${distro_codename}-security,label=Debian-Security";
};
Unattended-Upgrade::Automatic-Reboot "false";
Unattended-Upgrade::Automatic-Reboot-Time "03:00";
