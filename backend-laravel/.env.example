# =============================================================================
# OmniVote environment TEMPLATE — every value below is a PLACEHOLDER.
#
#   cp .env.example .env && php artisan key:generate
#
# then change each CHANGE_ME value for YOUR machine/host. The real .env is
# git-ignored; never commit it. Keys you can leave alone for a first local run:
# everything except APP_URL, FRONTEND_URL and the database block.
# =============================================================================
APP_NAME=OmniVote
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# CHANGE_ME: the origin users actually reach this server on.
#   local dev : APP_ENV=local, APP_DEBUG=true, APP_URL=http://localhost:8000
#   production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://your-host
# Production also requires SESSION_SECURE_COOKIE=true — the deploy aborts
# otherwise (artisan security:assert-production-config).
APP_URL=https://omnivote.example.edu

# Frontend origin: used for CORS and for the link inside password-reset e-mail;
# config/app.php falls back to APP_URL then to http://localhost:5173. In the
# current deployment the React console is served from the SAME origin as the API
# (nginx serves /admin/ and /api/ from one host), so this is simply APP_URL and
# reset links no longer point at localhost. For a split dev setup use
# http://localhost:5173.
FRONTEND_URL=https://omnivote.example.edu

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Secure cookies must be explicitly enabled behind HTTPS:
#   SESSION_SECURE_COOKIE=true   (required in production / Tailscale HTTPS)
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Hosts the API will answer to. The TrustHosts middleware rejects any request
# whose Host header is not listed with a 400, so this is a security control
# (assessment L-1: an unvalidated Host header lets a caller make url()/asset()
# emit links to THEIR domain). The list is always APP_URL's host, FRONTEND_URL's
# host and the loopback names `php artisan serve` uses; this key only ADDS to it,
# and it is inactive when APP_ENV=local. Leave empty unless users reach the server
# by a name that appears in none of those — then list it and clear the config
# cache (php artisan config:clear), e.g.:
#   TRUSTED_HOSTS=100.84.115.25,vote.example.edu
TRUSTED_HOSTS=

# Mobile bearer tokens expire after this many minutes (default 30 days).
# Keep this set in production so a leaked token is not valid forever.
SANCTUM_TOKEN_EXPIRATION=43200

# Cookie/session hardening. Production MUST set SESSION_SECURE_COOKIE=true (the
# deploy aborts if it is not — see the guard command above).
#
# SANCTUM_STATEFUL_DOMAINS is only needed when the admin console is served from a
# DIFFERENT origin than the API. The nginx setup in deploy/ serves both from one
# origin, so it is not needed: config/sanctum.php already falls back to the
# APP_URL host plus loopback. Setting it to a value that does not match the real
# host is exactly what silently breaks admin logins (login 200s, every call after
# it 401s), so leave this commented unless you have a genuinely split-origin setup:
# SANCTUM_STATEFUL_DOMAINS=omnivote.example.edu,localhost,localhost:5173,127.0.0.1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
